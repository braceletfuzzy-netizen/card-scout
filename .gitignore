# Card Scout — gitignore

# Secrets — NEVER commit
.env
*.env
config/*-token.txt
config/*.credentials.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node (actor builds)
node_modules/
package-lock.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local DB overrides
*.db-journal
*.db-wal
*.db-shm
card_scout.db

# Secrets — never commit
config/gcp-service-account.json
config/*.credentials.json

# Session working memory — never commit (Sessions/ is shared, .hermes/sessions/ is per-agent)
Sessions/
.hermes/sessions/
